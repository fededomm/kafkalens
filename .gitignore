# --- build output ---
bin/
build/bin/
build/dmg/
# build/appicon.png and build/windows/ are Wails inputs (app icon, exe manifest): keep them committed

# --- frontend (web/.gitignore covers the rest) ---
web/dist/
web/node_modules/
web/.angular/
# generated by wails dev / wails build without -skipbindings
web/wailsjs/
web/package.json.md5

# --- secrets: SASL passwords, TLS keys ---
clusters.json
*.pem
*.key
*.p12
*.pfx
.env
.env.*

# --- local tooling ---
.claude/settings.local.json
/.idea/
/.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Go / Python leftovers ---
*.test
*.out
coverage*
__pycache__/
.venv/

# --- not published (kept from the previous .gitignore) ---
scripts/
tmp/*
.diagram-design